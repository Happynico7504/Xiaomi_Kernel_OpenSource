#!/bin/sh
# Copy the fakekms fbdev udev rule into the initramfs, where plymouth
# starts the boot splash.
#
# Install to /etc/initramfs-tools/hooks/fakekms-fbdev (mode 755) and run
# update-initramfs -u.

PREREQ="udev"

prereqs()
{
	echo "$PREREQ"
}

case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

. /usr/share/initramfs-tools/hook-functions

RULES=/etc/udev/rules.d/70-fakekms-fbdev.rules

if [ ! -e "$RULES" ]; then
	echo "W: fakekms-fbdev: $RULES not found, skipping" >&2
	exit 0
fi

mkdir -p "$DESTDIR/usr/lib/udev/rules.d"
cp -p "$RULES" "$DESTDIR/usr/lib/udev/rules.d/"

exit 0
